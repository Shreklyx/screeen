# Másold át .env néven – vagy futtasd a deploy/install.sh-t, az kitölti.

# A domain, amin az oldal elérhető (a Caddy erre kér HTTPS tanúsítványt)
DOMAIN=mozizas.hu

# Ezzel a jelszóval lehet megosztást indítani (nézni a linkkel bárki tud)
HOST_PASSWORD=

# A TURN relé közös titka (a telepítő generálja; csak betűk és számok)
TURN_SECRET=

# A szerver nyilvános IPv4 címe; ha a szerver NAT mögött van: NYILVÁNOS/BELSŐ (pl. 1.2.3.4/10.0.0.5)
TURN_EXTERNAL_IP=

# A TURN relé UDP porttartománya (a tűzfalon is nyitva kell legyen)
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
